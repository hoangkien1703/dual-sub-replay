    <string name="ai_welcome_message">Ask about a setting, a word, a sentence, or a problem in the app.</string>
    <string name="ai_intro_title">Meet your AI assistant</string>
    <string name="ai_intro_message">Ask anything while you watch, in your own words.</string>
    <string name="ai_intro_words">Explains words, grammar and the subtitle line you\'re on</string>
    <string name="ai_intro_settings">Changes settings and replays lines for you, with Undo</string>
    <string name="ai_intro_problems">Helps when translation or subtitles stop working</string>
    <string name="ai_intro_files">Reads photos and files you add</string>
    <string name="ai_intro_privacy">It uses your own API key from a service you choose. Google Gemini and OpenRouter have free keys. Nothing is sent until you ask a question. AI can make mistakes, so check answers that matter.</string>
