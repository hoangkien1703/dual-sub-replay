<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower. Leaves out downloads the app can fetch again, so backups stay small:
    the Japanese dictionary (13 MB) and the F-Droid build's translation models. Also leaves out
    the WebView profile (app_webview/), whose cookies hold the YouTube/Google sign-in, and the AI
    assistant's encrypted keys (useless without this phone's Keystore) and saved chats. Keep these
    paths in sync with data_extraction_rules.xml and the directories AppViewModel and
    AiAssistantViewModel create.
-->
<full-backup-content>
    <exclude domain="file" path="japanese-dictionary/" />
    <exclude domain="file" path="translation-models/" />
    <exclude domain="root" path="app_webview/" />
    <exclude domain="sharedpref" path="ai_assistant_keys.xml" />
    <exclude domain="file" path="ai-chats/" />
</full-backup-content>
