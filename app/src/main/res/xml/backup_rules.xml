<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower. Leaves out downloads the app can fetch again, so backups stay small:
    the Japanese dictionary (13 MB). Also leaves out the WebView profile (app_webview/), whose
    cookies hold the YouTube/Google sign-in, the AI assistant's encrypted keys (useless
    without this phone's Keystore), saved chats, and memories and instructions, and the sentence
    clips and pictures recorded for Anki cards (line-audio/, about 25 KB each, and line-pictures/). Keep these paths
    in sync with data_extraction_rules.xml and the directories AppViewModel and
    AiAssistantViewModel create.
-->
<full-backup-content>
    <exclude domain="file" path="japanese-dictionary/" />
    <exclude domain="root" path="app_webview/" />
    <exclude domain="sharedpref" path="ai_assistant_keys.xml" />
    <exclude domain="file" path="ai-chats/" />
    <exclude domain="file" path="ai-memory/" />
    <exclude domain="file" path="line-audio/" />
    <exclude domain="file" path="line-pictures/" />
</full-backup-content>
