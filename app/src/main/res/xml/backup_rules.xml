<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower. Leaves out downloads the app can fetch again, so backups stay small:
    the Japanese dictionary (13 MB) and the F-Droid build's translation models. Keep these paths
    in sync with data_extraction_rules.xml and the directories AppViewModel creates.
-->
<full-backup-content>
    <exclude domain="file" path="japanese-dictionary/" />
    <exclude domain="file" path="translation-models/" />
</full-backup-content>
