<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Study tools (2026-10-20): play modes, skip silence, known words, AnkiDroid, blur box, page token -->
    <string name="settings_section_study_title">학습 도구</string>
    <string name="settings_section_flashcards_title">플래시카드 및 Anki</string>
    <string name="study_play_mode_title">재생 모드</string>
    <string name="study_play_mode_normal">보통</string>
    <string name="study_play_mode_normal_description">동영상을 평소처럼 재생합니다.</string>
    <string name="study_play_mode_pause_after">각 줄 뒤에 일시정지</string>
    <string name="study_play_mode_pause_after_description">자막 한 줄이 끝날 때마다 일시정지합니다. 재생을 누르면 다음 줄로 넘어갑니다.</string>
    <string name="study_play_mode_read_first">먼저 읽기</string>
    <string name="study_play_mode_read_first_description">각 줄의 시작에서 멈춰 듣기 전에 읽을 수 있습니다.</string>
    <string name="study_play_mode_listen_first">먼저 듣기</string>
    <string name="study_play_mode_listen_first_description">재생 중에는 자막을 숨기고, 각 줄 뒤에 일시정지하며 자막을 보여 줍니다.</string>
    <string name="study_play_mode_dictation">받아쓰기</string>
    <string name="study_play_mode_dictation_description">들은 내용을 입력할 때까지 각 줄을 숨깁니다. 각 줄 뒤에 동영상이 일시정지되고, 확인을 누르면 놓친 부분을 볼 수 있습니다. 사람이 만든 자막에서 가장 잘 작동합니다. 자동 자막에는 오류가 있을 수 있습니다.</string>
    <string name="study_play_mode_repeat">각 줄 반복</string>
    <string name="study_play_mode_repeat_description">각 줄을 여러 번 재생한 뒤 다음으로 넘어갑니다. 계속을 고르면 다른 줄을 탭하거나 탐색할 때까지 그 줄을 반복합니다.</string>
    <string name="study_repeat_forever">계속</string>
    <string name="study_play_mode_new_word">새 단어가 하나인 줄에서 일시정지</string>
    <string name="study_play_mode_new_word_description">아직 모르는 단어가 정확히 하나 있는 줄 뒤에서만 일시정지합니다. 아는 단어가 필요합니다.</string>
    <string name="study_play_mode_needs_known_words">이 모드를 쓰려면 아래의 아는 단어를 켜세요.</string>
    <string name="study_play_mode_note">재생 모드와 무음 건너뛰기는 전체 자막이 불러와졌을 때 작동하며, 실시간 자막에서는 작동하지 않습니다.</string>
    <string name="study_skip_silence_title">무음 건너뛰기</string>
    <string name="study_skip_silence_description">자막 줄이 없는 부분이 1.5초보다 길면 빠르게 재생하거나 건너뜁니다. 다음 줄 전에 원래 속도로 돌아옵니다.</string>
    <string name="study_skip_silence_off">끄기</string>
    <string name="study_skip_silence_2x">2×</string>
    <string name="study_skip_silence_4x">4×</string>
    <string name="study_skip_silence_jump">건너뛰기</string>
    <string name="study_known_words_title">아는 단어</string>
    <string name="study_known_words_description">각 동영상에서 이미 아는 비율을 보여 줍니다. 자동은 충분한 줄에서 본 단어도 아는 단어로 셉니다(한 줄은 동영상마다 한 번만 세고, 저장한 단어는 세지 않습니다). 수동은 단어 카드의 \"이 단어를 알아요\"만 사용합니다.</string>
    <string name="study_mark_new_words_title">자막에서 새 단어 표시</string>
    <string name="study_mark_new_words_description">모르고 저장하지 않은 단어에 옅은 배경을 넣습니다.</string>
    <string name="study_known_words_clear">아는 단어 지우기</string>
    <string name="study_known_words_clear_title">아는 단어를 지울까요?</string>
    <string name="study_known_words_clear_message">모든 언어에서 아는 단어로 표시한 단어가 모두 지워집니다. 저장한 단어는 남습니다.</string>
    <string name="study_known_words_clear_confirm">지우기</string>
    <string name="study_anki_title">플래시카드 앱으로 보내기</string>
    <string name="study_anki_description">단어 카드와 연습 → 내보내기에 보내기 버튼을 표시합니다. 버튼의 ▾ 또는 아래에서 다른 앱을 고르지 않으면 AnkiDroid로 보냅니다. 고른 앱은 버튼에 표시됩니다.</string>
    <string name="study_card_picture_description">단어가 나온 문장이 화면에 있을 때 동영상에서 찍은 그림을 카드에 넣습니다. 그림이 없으면 동영상 썸네일을 씁니다.</string>
    <string name="study_card_word_sound_title">단어 소리</string>
    <string name="study_card_word_sound_description">단어 카드가 쓰는 목소리로 읽은 단어.</string>
    <string name="study_card_sentence_sound_title">문장 소리</string>
    <string name="study_card_sentence_sound_description">동영상에서 가져온 문장의 실제 소리. 문장이 재생되는 동안 녹음되므로, 문장이 끝나기 전에 보낸 카드는 문장이 끝날 때 소리를 받습니다.</string>
    <string name="study_card_sentence_sound_listening">듣기 카드는 항상 앞면에서 재생합니다.</string>
    <string name="study_card_picture_place_title">그림</string>
    <string name="study_card_place_front">앞면</string>
    <string name="study_card_place_back">뒷면</string>
    <string name="study_card_place_off">끄기</string>
    <string name="study_card_place_note">Anki는 답 위에 앞면을 보여 주므로, 앞면에 있는 것은 뒷면에도 보입니다.</string>
    <string name="study_card_front_title">카드 앞면</string>
    <string name="study_card_front_word_sentence">단어와 문장</string>
    <string name="study_card_front_word">단어</string>
    <string name="study_card_front_sentence">문장</string>
    <string name="study_card_front_listening">듣기</string>
    <string name="study_card_front_word_sentence_description">앞면에 단어와 그 문장을 보여 줍니다.</string>
    <string name="study_card_front_word_description">앞면에는 단어만 보여 주고, 문장은 뒷면에 있습니다.</string>
    <string name="study_card_front_sentence_description">앞면에 단어를 굵게 표시한 문장을 보여 주고, 단어와 뜻은 뒷면에 있습니다.</string>
    <string name="study_card_front_listening_description">앞면에서는 문장의 소리만 재생하고, 문장과 단어는 뒷면에 있습니다.</string>
    <string name="study_card_front_note">이 설정을 바꾸면 전에 보낸 카드도 바뀝니다.</string>
    <string name="study_card_sound_waits">문장 소리는 문장이 끝까지 재생된 뒤에 추가됩니다.</string>
    <string name="study_card_sound_replaying">카드에 소리를 넣기 위해 문장을 한 번 재생하는 중입니다.</string>
    <string name="study_blur_box_title">흐림 상자</string>
    <string name="study_blur_box_description">동영상 위에 흐림 상자를 놓아 화면에 새겨진 자막을 가립니다. 끌어서 옮기고, 모서리를 끌어 크기를 바꿉니다.</string>
    <string name="study_page_token_title">페이지 토큰으로 자막 불러오기(베타)</string>
    <string name="study_page_token_description">자동은 YouTube가 빈 자막을 보낼 때만 토큰을 사용하고, 그 방법이 계속 통하는 동안 다음 동영상부터 토큰을 먼저 사용합니다. 켜기는 항상 토큰을 먼저 사용합니다. 끄기는 토큰을 만들지 않습니다.</string>
