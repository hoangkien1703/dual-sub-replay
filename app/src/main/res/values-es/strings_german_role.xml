    <string name="german_why_subject">Sujeto de la oración, por eso está en nominativo.</string>
    <string name="german_why_direct">Complemento directo del verbo, por eso está en acusativo.</string>
    <string name="german_why_dative">Complemento en dativo: %1$s rige dativo.</string>
    <string name="german_why_dative_plain">Complemento indirecto, por eso está en dativo.</string>
    <string name="german_why_after_prep">Sigue a la preposición \"%1$s\", que rige %2$s.</string>
    <string name="german_why_reflexive_verb">Reflexivo: repite el sujeto, con el verbo %1$s.</string>
    <string name="german_why_reflexive">Reflexivo: repite el sujeto de la oración.</string>
    <string name="german_why_relative">Se refiere a \"%1$s\" y abre una oración con el verbo al final. El género y el número vienen de ese sustantivo, el caso de su función en la oración.</string>
    <string name="german_why_relative_plain">Abre una oración de relativo con el verbo al final. El género y el número vienen del sustantivo al que se refiere.</string>
    <string name="german_why_demonstrative">Probablemente un pronombre demostrativo solo, no un artículo ante un sustantivo.</string>
    <string name="german_why_question_main">Palabra interrogativa: el verbo va en segundo lugar.</string>
    <string name="german_why_question_sub">Palabra interrogativa en una pregunta indirecta: el verbo va al final.</string>
    <string name="german_why_determiner">Acompaña a \"%1$s\" e indica su caso, género y número.</string>
    <string name="german_why_after_determiner">Los adjetivos que le siguen llevan terminaciones %1$s.</string>
    <string name="german_why_prep_case">\"%1$s\" rige %2$s.</string>
    <string name="german_why_prep_twoway">Preposición mixta (Wechselpräposition): acusativo para el movimiento hacia un lugar, dativo para la posición. Aquí: %1$s.</string>
    <string name="german_why_prep_fixed">Fija con \"%1$s\": aquí no funciona como preposición mixta.</string>
    <string name="german_why_prep_contraction">Contracción de la preposición y el artículo \"%1$s\".</string>
    <string name="german_why_coord">Une palabras u oraciones y no cambia la posición del verbo.</string>
    <string name="german_why_subord">Abre una subordinada: el verbo va al final (%1$s).</string>
    <string name="german_why_adj_attr">Va ante \"%1$s\" y concuerda con él, por eso lleva terminación: -%2$s (declinación %3$s).</string>
    <string name="german_why_adj_pred">Adjetivo predicativo tras \"%1$s\": no lleva terminación.</string>
    <string name="german_why_adj_adv">Adjetivo usado como adverbio con \"%1$s\": no lleva terminación y no es un adverbio aparte.</string>
    <string name="german_why_adv_verb">Modifica al verbo \"%1$s\".</string>
    <string name="german_why_adv_sentence">Comenta toda la frase.</string>
    <string name="german_why_adv_front">Abre la oración, así que el verbo va en segundo lugar y el sujeto lo sigue.</string>
    <string name="german_why_comparable">Tiene formas comparativas.</string>
    <string name="german_why_not_comparable">No admite comparación.</string>
    <string name="german_why_degree">Palabra de grado: intensifica \"%1$s\".</string>
    <string name="german_why_tentative">No es seguro: la línea admite más de una lectura.</string>
