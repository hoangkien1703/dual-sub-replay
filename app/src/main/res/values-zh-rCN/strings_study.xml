<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Study tools (2026-10-20): play modes, skip silence, known words, AnkiDroid, blur box, page token -->
    <string name="settings_section_study_title">学习工具</string>
    <string name="settings_section_study_summary">播放模式、跳过静音、已认识的词、AnkiDroid、模糊框</string>
    <string name="study_play_mode_title">播放模式</string>
    <string name="study_play_mode_normal">正常</string>
    <string name="study_play_mode_normal_description">视频照常播放。</string>
    <string name="study_play_mode_pause_after">每行之后暂停</string>
    <string name="study_play_mode_pause_after_description">每行字幕结束时暂停。按播放进入下一行。</string>
    <string name="study_play_mode_read_first">先读</string>
    <string name="study_play_mode_read_first_description">在每行开头停下，让你先读再听。</string>
    <string name="study_play_mode_listen_first">先听</string>
    <string name="study_play_mode_listen_first_description">播放时隐藏字幕，每行之后暂停并显示字幕。</string>
    <string name="study_play_mode_repeat">每行重复</string>
    <string name="study_play_mode_repeat_description">每行播放几遍后再继续。</string>
    <string name="study_play_mode_new_word">只在有一个新词的行暂停</string>
    <string name="study_play_mode_new_word_description">只在恰好有一个你还不认识的词的行之后暂停。需要已认识的词。</string>
    <string name="study_play_mode_needs_known_words">打开下面的已认识的词才能使用此模式。</string>
    <string name="study_play_mode_note">播放模式和跳过静音在加载完整字幕后起作用，实时字幕时不起作用。</string>
    <string name="study_skip_silence_title">跳过静音</string>
    <string name="study_skip_silence_description">没有字幕行超过 1.5 秒的部分会加快播放或跳过。在下一行之前恢复你的速度。</string>
    <string name="study_skip_silence_off">关闭</string>
    <string name="study_skip_silence_2x">2×</string>
    <string name="study_skip_silence_4x">4×</string>
    <string name="study_skip_silence_jump">跳过</string>
    <string name="study_known_words_title">已认识的词</string>
    <string name="study_known_words_description">显示每个视频中你已认识的比例。自动模式下，在足够多的行中见过的词也会算作已认识（每行在每个视频中只算一次；已保存的词不计）。手动模式只使用词卡上的“我认识这个词”。</string>
    <string name="study_mark_new_words_title">在字幕中标记新词</string>
    <string name="study_mark_new_words_description">给既不认识也没保存的词加上浅色背景。</string>
    <string name="study_known_words_clear">清除已认识的词</string>
    <string name="study_known_words_clear_title">清除已认识的词？</string>
    <string name="study_known_words_clear_message">所有语言中标记为认识的词都会被忘记。已保存的词会保留。</string>
    <string name="study_known_words_clear_confirm">清除</string>
    <string name="study_anki_title">发送到 AnkiDroid</string>
    <string name="study_anki_description">安装 AnkiDroid 后，在词卡和练习 → 导出中显示“发送到 AnkiDroid”。卡片会放入 DualSub Replay 牌组。请让 AnkiDroid 在后台保持打开：在很多手机上，它只在运行时接受卡片。</string>
    <string name="study_blur_box_title">模糊框</string>
    <string name="study_blur_box_description">在视频上放一个模糊框，遮住画面里自带的字幕。拖动可移动，拖动角可调整大小。</string>
    <string name="study_page_token_title">用页面令牌加载字幕（测试版）</string>
    <string name="study_page_token_description">自动：只在 YouTube 返回空字幕时使用令牌，只要仍然有效，之后的视频会先用令牌。开启：总是先用令牌。关闭：从不生成令牌。</string>
    <string name="study_comprehension_chip">已认识 %1$d%%</string>
    <string name="study_comprehension_title">这个视频中已认识的词</string>
    <string name="study_comprehension_known">你认识这个视频中 %1$d%% 的词。</string>
    <string name="study_mark_all_known">把所有新词标记为认识</string>
    <string name="study_mark_all_known_confirm">标记为认识</string>
    <string name="study_close">关闭</string>
    <string name="study_known_word_toggle">我认识这个词</string>
