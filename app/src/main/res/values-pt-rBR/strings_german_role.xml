    <string name="german_why_subject">Sujeito da oração, por isso está no nominativo.</string>
    <string name="german_why_direct">Objeto direto do verbo, por isso está no acusativo.</string>
    <string name="german_why_dative">Objeto no dativo: %1$s rege dativo.</string>
    <string name="german_why_dative_plain">Objeto indireto, por isso está no dativo.</string>
    <string name="german_why_after_prep">Segue a preposição \"%1$s\", que rege %2$s.</string>
    <string name="german_why_reflexive_verb">Reflexivo: repete o sujeito, com o verbo %1$s.</string>
    <string name="german_why_reflexive">Reflexivo: repete o sujeito da oração.</string>
    <string name="german_why_relative">Refere-se a \"%1$s\" e abre uma oração com o verbo no fim. O género e o número vêm desse substantivo, o caso da sua função na oração.</string>
    <string name="german_why_relative_plain">Abre uma oração relativa com o verbo no fim. O género e o número vêm do substantivo a que se refere.</string>
    <string name="german_why_demonstrative">Provavelmente um pronome demonstrativo isolado, não um artigo antes de um substantivo.</string>
    <string name="german_why_question_main">Palavra interrogativa: o verbo vem em segundo lugar.</string>
    <string name="german_why_question_sub">Palavra interrogativa numa pergunta indireta: o verbo vai para o fim.</string>
    <string name="german_why_determiner">Acompanha \"%1$s\" e indica o seu caso, género e número.</string>
    <string name="german_why_after_determiner">Os adjetivos que o seguem têm terminações %1$s.</string>
    <string name="german_why_prep_case">\"%1$s\" rege %2$s.</string>
    <string name="german_why_prep_twoway">Preposição mista (Wechselpräposition): acusativo para movimento até um lugar, dativo para posição. Aqui: %1$s.</string>
    <string name="german_why_prep_fixed">Fixa com \"%1$s\": aqui não funciona como preposição mista.</string>
    <string name="german_why_prep_contraction">Contração da preposição com o artigo \"%1$s\".</string>
    <string name="german_why_coord">Liga palavras ou orações e não altera a posição do verbo.</string>
    <string name="german_why_subord">Abre uma subordinada: o verbo vai para o fim (%1$s).</string>
    <string name="german_why_adj_attr">Está antes de \"%1$s\" e concorda com ele, por isso tem terminação: -%2$s (declinação %3$s).</string>
    <string name="german_why_adj_pred">Adjetivo predicativo depois de \"%1$s\": não tem terminação.</string>
    <string name="german_why_adj_adv">Adjetivo usado como advérbio com \"%1$s\": não tem terminação e não é um advérbio à parte.</string>
    <string name="german_why_adv_verb">Modifica o verbo \"%1$s\".</string>
    <string name="german_why_adv_sentence">Comenta toda a frase.</string>
    <string name="german_why_adv_front">Abre a oração, por isso o verbo vem em segundo lugar e o sujeito segue-o.</string>
    <string name="german_why_comparable">Tem formas comparativas.</string>
    <string name="german_why_not_comparable">Não admite comparação.</string>
    <string name="german_why_degree">Palavra de grau: intensifica \"%1$s\".</string>
    <string name="german_why_tentative">Não é certo: a linha admite mais de uma leitura.</string>
