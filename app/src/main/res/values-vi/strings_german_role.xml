    <string name="german_why_after_prep">Đứng sau giới từ \"%1$s\", giới từ này đi với %2$s.</string>
    <string name="german_why_reflexive_verb">Phản thân: lặp lại chủ ngữ, đi với động từ %1$s.</string>
    <string name="german_why_reflexive">Phản thân: lặp lại chủ ngữ của mệnh đề.</string>
    <string name="german_why_relative">Chỉ lại \"%1$s\" và mở đầu mệnh đề có động từ ở cuối. Giống và số theo danh từ đó, cách theo vai trò trong mệnh đề.</string>
    <string name="german_why_relative_plain">Mở đầu mệnh đề quan hệ có động từ ở cuối. Giống và số theo danh từ mà nó chỉ tới.</string>
    <string name="german_why_demonstrative">Có thể là đại từ chỉ định đứng một mình, không phải mạo từ trước danh từ.</string>
    <string name="german_why_question_main">Từ để hỏi: động từ đứng ở vị trí thứ hai.</string>
    <string name="german_why_question_sub">Từ để hỏi trong câu hỏi gián tiếp: động từ xuống cuối.</string>
    <string name="german_why_determiner">Đi với \"%1$s\" và cho biết cách, giống và số của nó.</string>
    <string name="german_why_after_determiner">Tính từ đứng sau nó có đuôi %1$s.</string>
    <string name="german_why_prep_case">\"%1$s\" đi với %2$s.</string>
    <string name="german_why_prep_twoway">Giới từ hai chiều (Wechselpräposition): accusative cho chuyển động tới nơi, dative cho vị trí. Ở đây: %1$s.</string>
    <string name="german_why_prep_fixed">Cố định với \"%1$s\": ở đây không dùng như giới từ hai chiều.</string>
    <string name="german_why_prep_contraction">Dạng rút gọn của giới từ và mạo từ \"%1$s\".</string>
    <string name="german_why_coord">Nối từ hoặc mệnh đề và không đổi vị trí động từ.</string>
    <string name="german_why_subord">Mở đầu mệnh đề phụ: động từ xuống cuối (%1$s).</string>
    <string name="german_why_adj_attr">Đứng trước \"%1$s\" và hợp với nó nên có đuôi: -%2$s (biến cách %3$s).</string>
    <string name="german_why_adj_pred">Tính từ vị ngữ sau \"%1$s\": không có đuôi.</string>
    <string name="german_why_adj_adv">Tính từ dùng như trạng từ với \"%1$s\": không có đuôi và không phải trạng từ riêng.</string>
    <string name="german_why_adv_verb">Bổ nghĩa cho động từ \"%1$s\".</string>
    <string name="german_why_adv_sentence">Nhận xét về cả câu.</string>
    <string name="german_why_adv_front">Nó mở đầu mệnh đề nên động từ đứng thứ hai, chủ ngữ theo sau.</string>
    <string name="german_why_comparable">Nó có dạng so sánh.</string>
